{
  "name": "nina-dwd-card",
  "version": "1.5.0",
  "description": "A Home Assistant Lovelace card for NINA and DWD warnings.",
  "homepage": "https://github.com/timmaurice/lovelace-nina-dwd-card#readme",
  "bugs": {
    "url": "https://github.com/timmaurice/lovelace-nina-dwd-card/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timmaurice/lovelace-nina-dwd-card.git"
  },
  "license": "MIT",
  "author": "Tim Maurice Bayer",
  "type": "module",
  "main": "dist/nina-dwd-card.js",
  "scripts": {
    "build": "rollup -c",
    "check-format": "prettier --check .",
    "format": "prettier . --write",
    "lint": "eslint .",
    "test": "NODE_ENV=production vitest run --reporter=verbose",
    "watch": "rollup -c -w"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.9.0",
    "home-assistant-js-websocket": "^9.6.0",
    "jsdom": "^30.0.1",
    "lit": "^3.3.3",
    "prettier": "^3.9.6",
    "rollup": "^4.62.4",
    "rollup-plugin-lit-css": "^6.0.1",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
